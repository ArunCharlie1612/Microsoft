# ─────────────────────────────────────────────────────────────
# BreachSim — Backend environment variables
# Copy to backend/.env and fill in real values. NEVER commit secrets.
# ─────────────────────────────────────────────────────────────

# --- App ---
APP_ENV=local                       # local | dev | prod
# Deployment environment — controls the data-store fallback policy:
#   local       → in-memory store allowed when Cosmos is not configured (dev convenience)
#   development → Cosmos required; startup fails if COSMOS_CONNECTION_STRING is unset
#   production  → Cosmos required; startup fails if COSMOS_CONNECTION_STRING is unset
ENVIRONMENT=local                   # local | development | production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<your-aoai>.openai.azure.com/
AZURE_OPENAI_API_KEY=                # leave blank to use Managed Identity
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large

# --- Azure AI Foundry ---
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://<project>.services.ai.azure.com/api/projects/<proj>
AZURE_AI_FOUNDRY_PROJECT_NAME=breachsim

# --- Azure AI Search (CVE vector index) ---
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=cve-index

# --- Cosmos DB ---
COSMOS_ENDPOINT=https://<your-cosmos>.documents.azure.com:443/
COSMOS_KEY=                          # leave blank to use Managed Identity
# Full account connection string. Required in development/production (or supply
# COSMOS_ENDPOINT + Managed Identity). Leave blank only when ENVIRONMENT=local.
COSMOS_CONNECTION_STRING=
COSMOS_DATABASE=breachsim
COSMOS_CONTAINER_FINDINGS=findings
COSMOS_CONTAINER_AGENTS=agent_events
COSMOS_CONTAINER_THREATGRAPH=threat_graph
COSMOS_CONTAINER_AUDIT=audit_log

# --- Event Grid (agent message bus) ---
EVENTGRID_TOPIC_ENDPOINT=https://<topic>.<region>-1.eventgrid.azure.net/api/events
EVENTGRID_TOPIC_KEY=

# --- Azure Service Bus (durable swarm run queue) ---
# Leave the connection string blank to run swarms in-process (local/dev).
# When set, POST /v1/runs enqueues runs and worker.py executes them durably.
AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://<your-namespace>.servicebus.windows.net/;SharedAccessKeyName=<policy>;SharedAccessKey=<key>
AZURE_SERVICE_BUS_QUEUE_NAME=breachsim-runs

# --- Key Vault ---
AZURE_KEY_VAULT_URI=https://<your-kv>.vault.azure.net/

# --- Entra ID (zero-trust auth) ---
# Enterprise SSO ("Sign in with Microsoft"). Register an app at
# https://learn.microsoft.com/azure/active-directory/develop/quickstart-register-app
# and add AZURE_REDIRECT_URI as a Web redirect URI. All four values are required to
# enable the /auth/login flow; leave them blank for local dev (API-key auth still works).
AZURE_TENANT_ID=                     # Directory (tenant) ID, e.g. 00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=                     # Application (client) ID from the app registration
AZURE_CLIENT_SECRET=                 # Client secret value (prefer Managed Identity in prod)
AZURE_REDIRECT_URI=http://localhost:8000/auth/callback  # must match a registered Web redirect URI
ENTRA_API_AUDIENCE=api://breachsim
# HS256 signing secret for BreachSim session JWTs issued after SSO login. Override in prod.
SESSION_JWT_SECRET=dev-insecure-session-secret-change-me
SESSION_JWT_TTL_MINUTES=60

# --- GitHub (remediation PRs) ---
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_REMEDIATION_REPO=<org>/<target-repo>

# --- Observability (Application Insights) ---
# Used by the API and worker.py for distributed tracing + run outcome logging.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Threat intelligence (NVD CVE enrichment) ---
NVD_API_KEY=                         # Optional — increases NVD rate limit from 5 to 50 req/30s

# --- Safety / scope guardrails ---
BREACHSIM_ALLOWED_SUBSCRIPTIONS=     # comma-separated allow-list
BREACHSIM_SANDBOX_ONLY=true          # never run live exploits outside sandbox
